#!/bin/sh
# Deck Video Player launcher.
#
# Works both inside the Flatpak (files under /app) and straight from a source
# checkout (files next to this script), which is handy for development.

set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
APPDIR=${DVP_APPDIR:-"$here/../share/deckvideoplayer"}
MPV=${DVP_MPV:-mpv}

CONFIG_DIR=${DVP_CONFIG_DIR:-"$HOME/.config/deckvideoplayer"}
DATA_DIR=${DVP_DATA_DIR:-"${XDG_DATA_HOME:-$HOME/.local/share}/deckvideoplayer"}
CONFIG_FILE="$CONFIG_DIR/config.ini"

# Everything the app creates is owner-only from the moment it exists:
# config.ini may hold an OpenSubtitles password, plex.json the Plex token
# (D39, D40). Existing files and folders keep their permissions.
umask 077

mkdir -p "$CONFIG_DIR" "$DATA_DIR"
if [ ! -f "$CONFIG_FILE" ]; then
    cp "$APPDIR/config.ini" "$CONFIG_FILE"
fi

# Read a single key from config.ini: ini_get <section> <key>
ini_get() {
    awk -v section="$1" -v key="$2" '
        /^[[:space:]]*[#;]/ { next }
        /^[[:space:]]*\[/ {
            s = $0; gsub(/^[[:space:]]*\[|\][[:space:]]*$/, "", s); cur = tolower(s); next
        }
        cur == section {
            line = $0
            i = index(line, "=")
            if (i == 0) next
            k = substr(line, 1, i - 1); v = substr(line, i + 1)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", k)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", v)
            # Same rules as dvp/config.lua: "gpu-context" = "gpu_context",
            # optional quotes around the value.
            k = tolower(k); gsub(/[[:space:]-]/, "_", k)
            if (v ~ /^".*"$/ || v ~ /^\047.*\047$/) v = substr(v, 2, length(v) - 2)
            if (k == key) val = v
        }
        END { print val }
    ' "$CONFIG_FILE"
}

set -- \
    --config-dir="$APPDIR/mpv" \
    --script-opts-append=deckplayer-config_file="$CONFIG_FILE" \
    --script-opts-append=deckplayer-data_dir="$DATA_DIR" \
    "$@"

# Under gamescope (SteamOS game mode) render through X11 + Vulkan so the
# gamescope WSI layer can hand mpv an HDR10 swapchain.
gpu_context=$(ini_get display gpu_context)
case "${gpu_context:-auto}" in
    auto)
        if [ -n "${GAMESCOPE_WAYLAND_DISPLAY:-}" ]; then
            set -- --gpu-context=x11vk "$@"
            # SteamOS sets this already; make sure the layer is active.
            export ENABLE_GAMESCOPE_WSI=1
        fi
        ;;
    *)
        set -- --gpu-context="$gpu_context" "$@"
        ;;
esac

# Controller input needs an mpv built with SDL2 gamepad support. The Flatpak's
# mpv always has it, so skip the probe there (it costs an extra mpv start);
# other builds would reject the option, hence the check.
if [ -f /.flatpak-info ] || "$MPV" --list-options 2>/dev/null | grep -q -- '--input-gamepad '; then
    set -- --input-gamepad=yes "$@"
fi

# Fonts in the Flatpak (D77): the runtime's fontconfig setup, minus the font
# caches mapped in from the host (50-flatpak.conf's /run/host/*-cache and
# remap-dir). With those, mpv crashed while quitting once a menu had been
# open: freeing a libass renderer's fontconfig setup freed memory inside a
# mapped host cache. The same fonts and rules are used; their caches are
# built once in the app's own cache folder. DVP_HOST_FONT_CACHE=1 skips this.
fc_runtime=/etc/fonts/conf.d
if [ -f /.flatpak-info ] && [ -f "$fc_runtime/50-flatpak.conf" ] && [ "${DVP_HOST_FONT_CACHE:-0}" != 1 ]; then
    fc_dir="${XDG_CACHE_HOME:-$HOME/.cache}/deckvideoplayer"
    fc_file="$fc_dir/fonts.conf"
    # In the order of the runtime's fonts.conf: folders, aliases, conf.d (with
    # 50-flatpak.conf replaced where it stands), then its cache folders.
    if mkdir -p "$fc_dir" && {
        printf '%s\n' '<?xml version="1.0"?>' '<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">' \
            '<!-- Written by the Deck Video Player launcher (D77). -->' '<fontconfig>' \
            '  <dir>/usr/share/fonts</dir>' '  <dir>/usr/local/share/fonts</dir>' \
            '  <dir prefix="xdg">fonts</dir>' '  <dir>~/.fonts</dir>'
        for pair in mono:monospace "sans serif:sans-serif" sans:sans-serif "system ui:system-ui"; do
            printf '  <match target="pattern"><test qual="any" name="family"><string>%s</string></test><edit name="family" mode="assign" binding="same"><string>%s</string></edit></match>\n' \
                "${pair%%:*}" "${pair#*:}"
        done
        for f in "$fc_runtime"/*.conf; do
            if [ "$f" = "$fc_runtime/50-flatpak.conf" ]; then
                # 50-flatpak.conf without the host's caches and remap-dir.
                printf '%s\n' '  <cachedir>/usr/lib/fontconfig/cache</cachedir>' '  <dir>/app/share/fonts</dir>' \
                    '  <cachedir>/app/cache/fontconfig</cachedir>' \
                    '  <include ignore_missing="yes">/app/etc/fonts/local.conf</include>' \
                    '  <dir>/run/host/fonts</dir>' '  <dir>/run/host/local-fonts</dir>' \
                    '  <dir>/run/host/user-fonts</dir>' '  <cachedir prefix="xdg">fontconfig</cachedir>'
            else
                printf '  <include ignore_missing="yes">%s</include>\n' "$f"
            fi
        done
        printf '%s\n' '  <cachedir>/usr/lib/fontconfig/cache</cachedir>' '  <cachedir prefix="xdg">fontconfig</cachedir>' \
            '  <cachedir>~/.fontconfig</cachedir>' '  <config><rescan><int>30</int></rescan></config>' '</fontconfig>'
    } > "$fc_file.tmp"; then
        # Replaced only when it changed (a runtime update).
        if [ -f "$fc_file" ] && [ "$(cat "$fc_file")" = "$(cat "$fc_file.tmp")" ]; then
            rm -f "$fc_file.tmp"
        else
            mv "$fc_file.tmp" "$fc_file"
        fi
        export FONTCONFIG_FILE="$fc_file"
    fi
fi

# Optional user overrides for mpv itself.
if [ -f "$CONFIG_DIR/mpv.conf" ]; then
    set -- "$@" --include="$CONFIG_DIR/mpv.conf"
fi

exec "$MPV" "$@"
